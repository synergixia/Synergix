# Synergix image-gen — RunPod Serverless worker (diffusers SDXL, CUDA).
#
# Build & push, then create a RunPod Serverless endpoint from this image:
#   docker build -f Dockerfile.serverless -t <user>/synergix-image-gen-serverless .
#   docker push <user>/synergix-image-gen-serverless
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

LABEL org.opencontainers.image.title="Synergix image-gen (serverless)"
LABEL org.opencontainers.image.description="Stable Diffusion XL RunPod Serverless worker (diffusers, CUDA)"

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# Serverless network volumes mount at /runpod-volume — cache SDXL there so it is
# not re-downloaded on every cold start.
ENV HF_HOME=/runpod-volume/hf-cache

WORKDIR /

# Pinned, mutually-compatible versions. The latest diffusers/transformers pull in
# a FlashAttention-3 op whose schema the base image's torch can't register
# (RuntimeError: infer_schema ... unsupported type torch.Tensor). This known-good
# stack predates that and works with torch 2.4.x. numpy<2 avoids torch/numpy2 ABI
# breakage. Keep the base image's torch (built for CUDA 12.4) — do not reinstall it.
RUN pip install --no-cache-dir \
        runpod \
        "numpy<2" \
        "diffusers==0.29.2" \
        "transformers==4.43.4" \
        "accelerate==0.33.0" \
        "huggingface_hub==0.24.6" \
        "safetensors==0.4.4" \
        pillow

COPY handler.py /handler.py

CMD ["python", "-u", "/handler.py"]
