# --- Telegram Config ---
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- Irys Storage Config ---
# Clave privada ECDSA (misma que usas en tu wallet BNB/ETH)
PRIVATE_KEY=your_ecdsa_private_key_here

# --- Wallet custodial automática ---
# Clave maestra que cifra los keystores de las wallets custodiales de los
# usuarios (contraseña HMAC por usuario + keystore V3/scrypt; a Irys solo
# sube el ciphertext). Genera una con: openssl rand -hex 32
# Si se deja vacía, la creación de wallets custodiales queda deshabilitada.
# ¡NUNCA la pierdas ni la publiques! Sin ella las wallets no se pueden abrir.
SYNERGIX_WALLET_MASTER_KEY=

# Nodo Irys (mainnet BNB por defecto)
IRYS_NODE_URL=https://uploader.irys.xyz
IRYS_GATEWAY_URL=https://gateway.irys.xyz
IRYS_TOKEN=bnb

# Microservicio interno de firma (Node.js + SDK oficial @irys/upload-ethereum)
IRYS_UPLOADER_URL=http://irys-uploader:8083

# --- IA Infrastructure (Docker Internal Names) ---
SYNERGIX_THINKER_HOST=http://synergix-ia-pensador:8081
SYNERGIX_JUDGE_HOST=http://synergix-ia-juez:8080
# Optional: cap concurrent Thinker calls (CPU runs llama.cpp --parallel 1):
# THINKER_MAX_CONCURRENCY=1

# --- Group chats ---
# In groups the bot answers only when the trigger word appears (whole word,
# case-insensitive) or when someone replies to the bot. DM stays full-featured
# (menu, points, contributions). Trigger word (default "syn"):
# SYNERGIX_GROUP_KEYWORD=syn
# Language the bot speaks in groups (default English):
# SYNERGIX_GROUP_LANG=en
# Whitelist of group IDs (negative numbers, comma-separated); empty = any group:
# SYNERGIX_GROUP_WHITELIST=-1001234567890,-1009876543210
# Min seconds between answers to the same user in a group (anti-spam):
# SYNERGIX_GROUP_COOLDOWN=5

# --- Web search fallback (used only when immortal memory has no answer) ---
# WEB_SEARCH_ENABLED=true
# Provider: "searxng" (self-hosted, private, default), "brave", or "duckduckgo".
# WEB_SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://searxng:8080
# Only if WEB_SEARCH_PROVIDER=brave (https://brave.com/search/api/):
# BRAVE_API_KEY=

# --- Image generation (Fal.ai) ---
# Fal.ai API key (from https://fal.ai/dashboard/keys), format "id:secret":
FAL_KEY=your_fal_key_here
# Model id (default fal-ai/flux/schnell). Others: fal-ai/flux/dev, fal-ai/fast-sdxl
# FAL_MODEL=fal-ai/flux/schnell
# Toggle the feature on/off:
# IMAGE_GEN_ENABLED=true
# Concurrent images allowed:
# IMAGE_MAX_CONCURRENCY=3
# Anti-abuse throttle (per user):
# IMAGE_COOLDOWN_SECONDS=120
# IMAGE_DAILY_LIMIT=10

# --- Administración ---
# UIDs numéricos de Telegram (separados por coma) autorizados para /admin
# (lock/unlock de emergencia). Obtén tu ID con @userinfobot en Telegram.
# SYNERGIX_ADMIN_IDS=123456789,987654321

# Anti-flood en DM: segundos mínimos entre mensajes de conversación de un
# mismo usuario (solo el camino que invoca al Thinker). 0 lo desactiva.
# SYNERGIX_DM_COOLDOWN=3

# Sincronizar el menú de comandos y la descripción del bot en el arranque.
# Son metadatos que rara vez cambian y Telegram los limita con flood control
# (un ban puede durar >20 min). Se ejecuta en segundo plano y nunca bloquea el
# arranque; ponlo en false si reinicias con frecuencia y ya están publicados.
# SYNERGIX_SYNC_BOT_META=true

# --- SIWE (Sign-In with Ethereum) ---
SYNERGIX_SIWE_DOMAIN=synergix.bot
SYNERGIX_SIWE_URI=https://synergix.bot
SYNERGIX_SIWE_CHAIN_ID=56

# --- BSC On-Chain (Trading) ---
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# Slippage (%) de los swaps custodiales de comprar/vender SYNERGIX. Holgado
# por defecto porque el token tiene tax + baja liquidez (evita reverts).
# SYNERGIX_SWAP_SLIPPAGE=12

# --- Bond de nodos (SYNERGIX real bloqueado — anti-spam) ---
# Crear un nodo exige bloquear este bond de SYNERGIX real en la wallet del
# usuario (no se mueve; solo se congela). Se libera tras el unbonding.
# SYNERGIX_NODE_BOND=20000
# SYNERGIX_UNBOND_DAYS=7
# --- Stake de Oráculo (SYNERGIX real bloqueado para ser juez — anti-Sybil) ---
# SYNERGIX_ORACLE_STAKE=100000

# --- Canje SYNX → SYNERGIX real (gate anti-Sybil, Fase B/C) ---
# El interruptor viene APAGADO: el gate funciona pero NO se paga nada hasta
# activarlo con el tesoro y el presupuesto de emisión (Fase C).
# SYNERGIX_REDEEM_ENABLED=false
# SYNERGIX_REDEEM_MIN_CONTRIBUTIONS=5     # aportes validados mínimos
# SYNERGIX_REDEEM_MIN_AMOUNT=100          # canje mínimo (SYNX)
# SYNERGIX_REDEEM_USER_CAP=5000           # tope por usuario / ventana
# SYNERGIX_REDEEM_ADDRESS_CAP=5000        # tope por dirección de pago / ventana
# SYNERGIX_REDEEM_ADDRESS_MAX_USERS=1     # Ghost IDs distintos por wallet (Sybil)
# SYNERGIX_REDEEM_WINDOW_HOURS=24
#
# --- Fase C: pago real del canje (tesoro hot wallet) ---
# Clave privada del TESORO (hot wallet SEPARADA de PRIVATE_KEY). Debe tener
# SYNERGIX para pagar + BNB para el gas. Guarda SOLO el float de ~1 día; el
# resto en una wallet cuya clave NO esté en el servidor. ¡Nunca la comitees!
# SYNERGIX_TREASURY_KEY=
# SYNERGIX_REDEEM_RATE=1.0                 # SYNERGIX real por cada SYNX
# SYNERGIX_REDEEM_DAILY_BUDGET=1000        # tope de emisión por día (soft-launch)
# Para ACTIVAR el pago: SYNERGIX_REDEEM_ENABLED=true (con tesoro fondeado).

# --- Fase D: bonds on-chain (contrato trustless) ---
# Dirección del contrato SynergixNodeBond YA DESPLEGADO Y AUDITADO. Vacío =
# se usa el bond contable de la Fase A. Ver contracts/README.md.
# SYNERGIX_BOND_CONTRACT=

# --- App Config ---
PYTHONPATH=/app
LOG_LEVEL=INFO
SYNERGIX_CACHE_TTL=12


# --- Web API (sitio web — fase B) ---
# Activa el endpoint HTTP que el sitio web usa para chat/judge/contribute.
# Corre en el mismo proceso del bot (comparte el RAG ya cargado).
WEB_API_ENABLED=false
# Clave compartida que el proxy de Vercel envía como X-API-Key. Genera una
# larga y aleatoria:  openssl rand -hex 32
WEB_API_KEY=
# Orígenes permitidos por CORS (coma-separados). Tu dominio del sitio.
WEB_CORS_ORIGINS=https://www.synergix.lol,https://synergix.lol
# Límite de peticiones por IP (ventana deslizante).
WEB_RATE_MAX=20
WEB_RATE_WINDOW=60
# Si las consultas web reparten puntos residuales a los autores de los
# aportes recuperados (escribe en Irys). Off por defecto.
WEB_RESIDUAL_REWARDS=false
