# --- Telegram Config ---
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- Irys Storage Config ---
# Clave privada ECDSA (misma que usas en tu wallet BNB/ETH)
PRIVATE_KEY=your_ecdsa_private_key_here

# Nodo Irys (mainnet BNB por defecto)
IRYS_NODE_URL=https://uploader.irys.xyz
IRYS_GATEWAY_URL=https://gateway.irys.xyz
IRYS_TOKEN=bnb

# Microservicio interno de firma (Node.js + SDK oficial @irys/upload-ethereum)
IRYS_UPLOADER_URL=http://irys-uploader:8083

# --- IA Infrastructure (Docker Internal Names) ---
SYNERGIX_THINKER_HOST=http://synergix-ia-pensador:8081
SYNERGIX_JUDGE_HOST=http://synergix-ia-juez:8080
# Optional: cap concurrent Thinker calls (CPU runs llama.cpp --parallel 1):
# THINKER_MAX_CONCURRENCY=1

# --- Image generation (SDXL on RunPod Serverless) ---
# Toggle the feature on/off:
# IMAGE_GEN_ENABLED=true
# Backend: "serverless" (RunPod Serverless) or "http" (pod / local CPU service).
IMAGE_GEN_MODE=serverless
# Serverless: the endpoint id + your RunPod API key (Settings → API Keys).
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
RUNPOD_API_KEY=your_runpod_api_key
# Concurrent images allowed — set to your endpoint's max workers (e.g. 3):
# IMAGE_MAX_CONCURRENCY=3
# Anti-abuse throttle (per user):
# IMAGE_COOLDOWN_SECONDS=120
# IMAGE_DAILY_LIMIT=10
#
# http/pod mode only (IMAGE_GEN_MODE=http):
# IMAGE_GEN_HOST=https://your-pod-id-8084.proxy.runpod.net
# IMAGE_GEN_API_KEY=shared_secret_matching_the_pod
#
# Local CPU fallback (IMAGE_GEN_MODE=http + `--profile local-image`):
# IMAGE_GEN_HOST=http://image-gen:8084
# SD_MODEL=/models/image/v1-5-pruned-emaonly.safetensors
# SD_WTYPE=q8_0

# --- SIWE (Sign-In with Ethereum) ---
SYNERGIX_SIWE_DOMAIN=synergix.bot
SYNERGIX_SIWE_URI=https://synergix.bot
SYNERGIX_SIWE_CHAIN_ID=56

# --- BSC On-Chain (Trading) ---
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# --- App Config ---
PYTHONPATH=/app
LOG_LEVEL=INFO
SYNERGIX_CACHE_TTL=12
