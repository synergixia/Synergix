# --- Telegram Config ---
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- Irys Storage Config ---
# Clave privada ECDSA (misma que usas en tu wallet BNB/ETH)
PRIVATE_KEY=your_ecdsa_private_key_here

# Nodo Irys (mainnet BNB por defecto)
IRYS_NODE_URL=https://uploader.irys.xyz
IRYS_GATEWAY_URL=https://gateway.irys.xyz
IRYS_TOKEN=bnb

# Microservicio interno de firma (Node.js + SDK oficial @irys/upload-ethereum)
IRYS_UPLOADER_URL=http://irys-uploader:8083

# --- IA Infrastructure (Docker Internal Names) ---
SYNERGIX_THINKER_HOST=http://synergix-ia-pensador:8081
SYNERGIX_JUDGE_HOST=http://synergix-ia-juez:8080

# --- Hybrid: Hetzner (CPU) + RunPod (GPU 24 GB) ---
# Single-box mode: leave these unset — defaults route to the local CPU
# containers (thinker-cpu / judge).
# Hybrid mode: set the primary hosts to the RunPod pod's Tailscale IP and the
# *_FALLBACK_HOST vars to the local CPU containers, then start with the overlay:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.hybrid.yml up -d
# THINKER_HOST=http://100.x.y.z:8081
# JUDGE_HOST=http://100.x.y.z:8080
# THINKER_FALLBACK_HOST=http://thinker-cpu:8081
# JUDGE_FALLBACK_HOST=http://judge:8080
# Concurrent Thinker calls — match the GPU pod's --parallel (default 1 = CPU):
# THINKER_MAX_CONCURRENCY=2
# Tailscale auth key for the Hetzner host sidecar (hybrid overlay only):
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# --- SIWE (Sign-In with Ethereum) ---
SYNERGIX_SIWE_DOMAIN=synergix.bot
SYNERGIX_SIWE_URI=https://synergix.bot
SYNERGIX_SIWE_CHAIN_ID=56

# --- BSC On-Chain (Trading) ---
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# --- App Config ---
PYTHONPATH=/app
LOG_LEVEL=INFO
SYNERGIX_CACHE_TTL=12
